<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app>

    <servlet>
        <servlet-name>sum1</servlet-name>
        <jsp-file>/add.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>sum1</servlet-name>
        <url-pattern>/add1</url-pattern>
    </servlet-mapping>

    <!-- ===================== -->
    <!-- 1. CONTEXT PARAMETERS -->
    <!-- ===================== -->
    <context-param>
        <param-name>appName</param-name>
        <param-value>Calculator</param-value>
    </context-param>

    <!-- ===================== -->
    <!-- 2. FILTER DEFINITIONS -->
    <!-- ===================== -->
    <filter>
        <filter-name>negative</filter-name>
        <filter-class>com.servlet.PositiveNumbers</filter-class>
    </filter>

    <!-- ===================== -->
    <!-- 3. FILTER MAPPINGS -->
    <!-- ===================== -->
    <filter-mapping>
        <filter-name>negative</filter-name>
        <url-pattern>/calculate</url-pattern>
    </filter-mapping>

    <!-- ===================== -->
    <!-- 4. SERVLET DEFINITIONS -->
    <!-- ===================== -->

    <servlet>
        <servlet-name>calculate</servlet-name>
        <servlet-class>com.servlet.Calculate</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>add</servlet-name>
        <servlet-class>com.servlet.SumServer</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>subtract</servlet-name>
        <servlet-class>com.servlet.Subtract</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>multiply</servlet-name>
        <servlet-class>com.servlet.Multiply</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>divide</servlet-name>
        <servlet-class>com.servlet.Divide</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>display</servlet-name>
        <servlet-class>com.servlet.DisplayResultServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>Header</servlet-name>
        <servlet-class>com.servlet.Header</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>Footer</servlet-name>
        <servlet-class>com.servlet.Footer</servlet-class>
    </servlet>

    <!-- ===================== -->
    <!-- 5. SERVLET MAPPINGS -->
    <!-- ===================== -->

    <servlet-mapping>
        <servlet-name>calculate</servlet-name>
        <url-pattern>/calculate</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>add</servlet-name>
        <url-pattern>/add</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>subtract</servlet-name>
        <url-pattern>/subtract</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>multiply</servlet-name>
        <url-pattern>/multiply</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>divide</servlet-name>
        <url-pattern>/divide</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>display</servlet-name>
        <url-pattern>/display</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>Header</servlet-name>
        <url-pattern>/header</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>Footer</servlet-name>
        <url-pattern>/footer</url-pattern>
    </servlet-mapping>

</web-app>
